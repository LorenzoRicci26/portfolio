{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/qwen36-27b",
  "small_model": "litellm/qwen36-27b",
  "default_agent": "plan",
  "share": "disabled",
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "ask",
    "external_directory": {
      "*": "deny"
    },
    "webfetch": "deny",
    "websearch": "deny",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "npm run build": "ask",
      "npm run dev": "ask",
      "npm test*": "ask",
      "pnpm build": "ask",
      "pnpm dev": "ask",
      "pnpm test*": "ask",
      "git add*": "ask",
      "git commit*": "ask",
      "git push*": "deny",
      "rm *": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "docker *": "deny"
    }
  }
}
