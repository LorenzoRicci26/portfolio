---
const { name, links } = Astro.props;
import LanguageToggle from './LanguageToggle.astro';
---

<nav class="fixed top-0 w-full z-50 backdrop-blur-md bg-neutral-950/80 border-b border-neutral-800" data-lang="it">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="text-lg font-bold tracking-tight hover:text-white transition-colors">
      {name}
    </a>
    <ul class="hidden md:flex items-center gap-6">
      {links.map(link => (
        <li>
          <a href={link.href} class="text-sm text-neutral-400 hover:text-white transition-colors">
            {link.label}
          </a>
        </li>
      ))}
      <li><LanguageToggle /></li>
     </ul>
  </div>
</nav>

---
