---
interface Experience {
  title: string;
  organization: string;
  period: string;
  description: string;
  type: 'education' | 'work';
}

const { items } = Astro.props;
---

<div class="relative">
  <!-- Vertical line that animates on scroll -->
  <div class="absolute left-0 md:left-1/2 top-0 bottom-0 w-px md:-translate-x-px">
    <div class="timeline-line h-full w-full bg-neutral-800 origin-top">
      <div class="timeline-line-fill h-0 w-full bg-emerald-500/60 rounded-full transition-all duration-300"></div>
    </div>
  </div>

  <div class="space-y-12 md:space-y-0">
    {items.map((item, index) => (
      <div
        class={`timeline-item relative flex flex-col md:flex-row md:items-center gap-4 md:gap-0 opacity-0 transition-all duration-700 ${
          index % 2 === 0 ? 'md:flex-row-reverse' : ''
        }`}
        style="--delay: ${index * 150}ms"
      >
        <!-- Spacer for the opposite side -->
        <div class="hidden md:block md:w-1/2" />

        <!-- Center dot -->
        <div class="timeline-dot absolute left-0 md:left-1/2 -translate-x-1/2 w-4 h-4 rounded-full border-2 border-emerald-500 bg-neutral-950 mt-1.5 md:mt-0 z-10 transition-all duration-500" />

        <!-- Content card -->
        <div class="ml-8 md:ml-0 md:w-1/2 md:px-10">
          <div class="timeline-card opacity-0 translate-y-4 transition-all duration-700" style="transition-delay: calc(var(--delay) + 200ms)">
            <span class={`inline-block text-xs font-medium px-2.5 py-1 rounded-full mb-3 ${
              item.type === 'education'
                ? 'bg-violet-500/10 text-violet-400 border border-violet-500/20'
                : 'bg-sky-500/10 text-sky-400 border border-sky-500/20'
            }`}>
              {item.type === 'education' ? 'Formazione' : 'Lavoro'}
            </span>
            <h3 class="text-xl font-semibold text-white mb-1">{item.title}</h3>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mb-3">
              <span class="text-sm text-neutral-300">{item.organization}</span>
              <span class="text-xs text-neutral-500">{item.period}</span>
            </div>
            <p class="text-neutral-400 text-sm leading-relaxed">{item.description}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<script is:inline>
  // Scroll-driven animation using IntersectionObserver
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('timeline-visible');
          // Reveal card
          const card = entry.target.querySelector('.timeline-card');
          if (card) {
            card.classList.add('timeline-card-visible');
          }
        }
      });
    },
    { threshold: 0.2, rootMargin: '0px 0px -50px 0px' }
  );

  document.querySelectorAll('.timeline-item').forEach((el) => observer.observe(el));
</script>

<style is:global>
  .timeline-item.timeline-visible {
    opacity: 1;
  }

  .timeline-card.timeline-card-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Line fill grows based on how many items are visible */
  .timeline-line {
    position: relative;
    overflow: hidden;
  }

  /* Update line fill height dynamically via JS */
</style>

<script is:inline>
  // Dynamically grow the timeline line as items come into view
  const updateLine = () => {
    const items = document.querySelectorAll('.timeline-item');
    if (!items.length) return;

    const container = items[0].closest('div[class^="relative"]');
    const lineFill = container?.querySelector('.timeline-line-fill');
    if (!lineFill) return;

    let visibleCount = 0;
    items.forEach((item) => {
      if (item.classList.contains('timeline-visible')) visibleCount++;
    });

    const percentage = (visibleCount / items.length) * 100;
    lineFill.style.height = `${percentage}%`;
  };

  const resizeObserver = new ResizeObserver(updateLine);
  document.querySelectorAll('.timeline-item').forEach((el) => {
    el.addEventListener('classlistchange', updateLine);
    resizeObserver.observe(el);
  });

  // Also update on scroll for smooth effect
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        updateLine();
        ticking = false;
      });
      ticking = true;
    }
  });
</script>
