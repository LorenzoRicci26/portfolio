---
const { headline, subheadline, ctaText, ctaHref } = Astro.props;
---

<section id="home" class="min-h-screen flex items-center justify-center pt-16">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-2xl">
      <p class="text-sm font-medium text-emerald-400 mb-6 tracking-widest uppercase">
        Benvenuto
      </p>
      <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight leading-[1.1] mb-6">
        {headline}
      </h1>
      <p class="text-lg md:text-xl text-neutral-400 leading-relaxed mb-10">
        {subheadline}
      </p>
      <a
        href={ctaHref}
        class="inline-flex items-center gap-2 bg-white text-neutral-950 font-semibold text-sm px-6 py-3 rounded-lg hover:bg-neutral-200 transition-colors"
      >
        {ctaText}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
