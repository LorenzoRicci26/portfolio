---
const { id, title, description } = Astro.props;
---

<section id={id} class="py-24 md:py-32">
  <div class="max-w-6xl mx-auto px-6">
    <div class="mb-16">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4">{title}</h2>
      {description && (
        <p class="text-neutral-400 max-w-xl">{description}</p>
      )}
    </div>
    <slot />
  </div>
</section>
